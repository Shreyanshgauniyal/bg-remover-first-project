# Required for background removal (server-side only). Do not use a VITE_ prefix.
REMOVE_BG_API_KEY=replace_with_your_remove_bg_api_key

# Optional: Supabase is only needed for accounts, saved projects, and database features.
# Copy this file to .env and fill in your own project values.
# Never commit .env or share API keys publicly.
SUPABASE_PROJECT_ID=your_supabase_project_id
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_SUPABASE_URL=https://your-project.supabase.co

# Server-side only: create a key at https://www.remove.bg/api

# Server-side Supabase secret needed for credit accounting.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_or_service_role_key
